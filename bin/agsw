#!/usr/bin/env bash
# =============================================================================
#  agsw —— Antigravity 多账号槽位管理（每个槽位一套独立配置目录）
#
#  Antigravity 本体只保存一个登录态（$XDG_CONFIG_HOME/Antigravity）。想同时挂多个账号，
#  给它不同的配置根目录即可：Electron 的 userData 跟着 XDG_CONFIG_HOME 走，
#  再叠加 --user-data-dir 做显式标记，两个槽位就能同时存在、互不干扰。
#
#  用法：
#    ./bin/agsw list                 列出槽位和运行状态
#    ./bin/agsw new work             新建槽位
#    ./bin/agsw run work             用 work 槽位启动
#    ./bin/agsw login 2              一步到位：槽位 2 + 登录弹窗指向 gacc 2 号
#    ./bin/agsw adopt 1              把现有的默认安装（~/.config/Antigravity + ~/.gemini）
#                                    复制进槽位 1（原目录保留，不动）
#    ./bin/agsw run work --gacc 2    同一次启动里，把登录弹窗指向 gacc 的 2 号账户
#    ./bin/agsw run work -- <参数>   把额外参数透传给 Antigravity
#    ./bin/agsw stop work            关掉该槽位
#    ./bin/agsw rm work              删除槽位（会二次确认）
#    ./bin/agsw status               只打印谁在跑
#
#  安全默认：
#    · 槽位全部落在 $AGSW_HOME（默认 ~/.local/share/agsw），不碰你的 ~/.config/Antigravity
#    · 每个槽位的真实状态在 <槽位>/userdata（Electron 认 --user-data-dir，单实例锁也按它隔离）
#    · 只有显式给 --gacc N 才会改系统默认浏览器，且之前的值会被记录，可 --revert-default 还原
#    · --dry-run 只打印将要执行的命令
# =============================================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGSW_HOME="${AGSW_HOME:-$HOME/.local/share/agsw}"
SLOTS="$AGSW_HOME/slots"
DRY=0
GACC=""
NO_BROWSER=0

say()  { printf '%s\n' "$*"; }
step() { printf '\n\033[32m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[31m✘ %s\033[0m\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- 二进制探测
find_bin() {
  if [[ -n "${AGSW_BIN:-}" ]]; then printf '%s\n' "$AGSW_BIN"; return; fi
  local c
  for c in \
    "$HOME/opt/antigravity/Antigravity-x64/antigravity" \
    "$ROOT/../opt/antigravity/Antigravity-x64/antigravity" \
    "$HOME/cc-499/opt/antigravity/Antigravity-x64/antigravity" \
    /opt/antigravity/Antigravity-x64/antigravity \
    /usr/lib/antigravity/antigravity ; do
    [[ -x "$c" ]] && { printf '%s\n' "$c"; return; }
  done
  command -v antigravity 2>/dev/null || true
}

slot_dir() { printf '%s/%s' "$SLOTS" "$1"; }

# 槽位在跑的证据：命令行里带 --user-data-dir=<槽位>
slot_pids() {
  local ud; ud="$(slot_dir "$1")/userdata"
  local pid cmd
  while read -r pid cmd; do
    case "$cmd" in
      *"--user-data-dir=$ud"*) printf '%s\n' "$pid" ;;
    esac
  done < <(ps -eo pid=,args= 2>/dev/null)
}

cmd_list() {
  [[ -d "$SLOTS" ]] || { say "还没有槽位。新建：$0 new <名字>"; return 0; }
  printf '%-12s %-8s %-11s %s\n' 槽位 状态 登录态 配置目录
  local d name pids size
  for d in "$SLOTS"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    pids="$(slot_pids "$name" | head -1)"
    if [[ -d "$d/userdata/Local Storage" || -d "$d/config/Antigravity" ]]; then size=有; else size=无; fi
    printf '%-12s %-8s %-11s %s\n' "$name" "$([[ -n "$pids" ]] && echo "运行中" || echo 停止)" "$size" "$d"
  done
}

cmd_status() {
  local d name pids
  for d in "$SLOTS"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    pids="$(slot_pids "$name" | tr '\n' ' ')"
    [[ -n "${pids// }" ]] && printf '%-12s pid %s\n' "$name" "$pids"
  done
}

cmd_new() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "槽位名只能用字母数字 . _ -"
  local d; d="$(slot_dir "$name")"
  if [[ -d "$d" ]]; then
    say "槽位已存在：$d"
  else
    if (( DRY )); then say "（dry-run）会创建 $d/{config,cache,data,userdata,logs}"; return 0; fi
    mkdir -p "$d"/{home,config,cache,data,userdata,logs}
    say "✔ 已创建槽位 $name → $d"
  fi
}

# 槽位有自己的 HOME，也就有自己的 mimeapps.list。不把关联搬进来，
# xdg-open 在槽位里就找不到浏览器，会落到 WSL 的兜底（打开 Windows 浏览器）。
sync_slot_xdg() {
  local name="$1" d; d="$(slot_dir "$1")"
  local def="${AGSW_DEFAULT_BROWSER:-}"
  # 槽位名是账户号时，默认配对同号的 gacc 账户（槽位 2 → gacc-acc02）
  if [[ -z "$def" && "$name" =~ ^[0-9]+$ ]]; then
    local cand; cand="$(printf 'gacc-acc%02d.desktop' "$name")"
    [[ -f "$HOME/.local/share/applications/$cand" ]] && def="$cand"
  fi
  if [[ -z "$def" ]]; then
    def="$(XDG_CONFIG_HOME="$HOME/.config" xdg-settings get default-web-browser 2>/dev/null || true)"
  fi
  [[ -z "$def" ]] && { say "! 没查到系统默认浏览器，槽位里点登录可能会落到 Windows 浏览器"; return 0; }
  local src=""
  for c in "$HOME/.local/share/applications/$def" "/usr/share/applications/$def"; do
    [[ -f "$c" ]] && { src="$c"; break; }
  done
  if [[ -z "$src" ]]; then
    say "! 找不到 $def 的 .desktop，槽位里的链接可能打不开"
    return 0
  fi
  mkdir -p "$d/home/.local/share/applications" "$d/home/.config"
  cp -f "$src" "$d/home/.local/share/applications/$def"
  cat > "$d/home/.config/mimeapps.list" <<MIME
[Default Applications]
x-scheme-handler/http=$def
x-scheme-handler/https=$def
x-scheme-handler/about=$def
text/html=$def
MIME
  say "  槽位内默认浏览器 → $def"
}

cmd_run() {
  local name="$1"; shift || true
  local bin; bin="$(find_bin)"
  [[ -n "$bin" ]] || die "找不到 antigravity 可执行文件。用 AGSW_BIN=/path/to/antigravity 指定"
  [[ -x "$bin" ]] || die "$bin 不可执行"

  local d; d="$(slot_dir "$name")"
  if [[ ! -d "$d" ]]; then
    (( DRY )) || { mkdir -p "$d"/{home,config,cache,data,userdata,logs}; say "（自动创建槽位 $name）"; }
  fi

  if [[ -n "$(slot_pids "$name" | head -1)" ]]; then
    say "! 槽位 $name 已经在运行（pid $(slot_pids "$name" | head -1)），不再启动第二个。"
    say "  要重启：$0 stop $name"
    return 0
  fi

  # 需要时把「系统默认浏览器」指向对应 gacc 账户，登录弹窗才会落进那个 profile
  if [[ -n "$GACC" ]] && (( ! NO_BROWSER )); then
    local setter="$ROOT/bin/install-shortcuts.sh"
    if [[ -x "$setter" ]]; then
      if (( DRY )); then
        say "（dry-run）会执行：$setter --accounts \"$GACC\" --as-default $GACC"
      else
        "$setter" --accounts "$GACC" --as-default "$GACC" >/dev/null 2>&1 \
          && say "✔ 登录弹窗已指向 gacc 账户 $GACC（原默认浏览器已记录，可 --revert-default 还原）" \
          || say "! 设置默认浏览器失败，登录弹窗可能落在别的浏览器里"
      fi
    fi
  fi

  if (( ! DRY )); then sync_slot_xdg "$name"; fi

  local -a cmd=("$bin" "--user-data-dir=$(slot_dir "$name")/userdata" "$@")
  if (( DRY )); then
    say "（dry-run）会执行："
    printf '  HOME=%s/home （槽位内自带 .config/mimeapps.list 与 .local/share/applications）\\\n    %q' \
      "$d" "${cmd[0]}"
    printf ' %q' "${cmd[@]:1}"; printf '\n'
    return 0
  fi

  step "启动槽位 $name"
  # 必须连 HOME 一起换：Antigravity 把登录态放在 $HOME/.gemini（oauth_creds.json 等），
  # 那不在 Electron 的 userData 里，只换 --user-data-dir 会让所有槽位共用同一个账号。
  setsid --fork nohup env \
      HOME="$d/home" \
      XDG_CACHE_HOME="$d/cache" \
      GSETTINGS_BACKEND=memory \
      "${cmd[@]}" </dev/null >>"$d/logs/launch.log" 2>&1 &

  local pid=""
  for _ in $(seq 1 40); do
    pid="$(slot_pids "$name" | head -1)"; [[ -n "$pid" ]] && break; sleep 0.3
  done
  sleep 2
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    say "✔ 槽位 $name 已启动 (pid $pid)"
    say "  配置目录 : $d"
    say "  登录态   : $([[ -d "$d/config/Antigravity" ]] && echo 已生成 || echo 首次启动会在授权后生成)"
    say "  日志     : $d/logs/launch.log"
  else
    say "✘ 启动失败，日志末尾："
    grep -viE 'dconf|Fontconfig|libva|gbm|vaapi|EGL|GLX|Vulkan' "$d/logs/launch.log" 2>/dev/null | tail -8
    return 1
  fi
}

# 一步到位：槽位名用账户号，浏览器也指向同一个账户
cmd_login() {
  local name="$1"
  [[ "$name" =~ ^[0-9]+$ ]] || die "login 后面要跟账户号（例如 2），对应 gacc 的 2 号 profile"
  GACC="${GACC:-$name}"
  cmd_new "$name"
  cmd_run "$name" "${ARGS[@]:1}"
}

# 把「默认位置」的那份安装复制进某个槽位（不移动，原样保留）
cmd_adopt() {
  local name="$1" d
  d="$(slot_dir "$name")"
  local src_ud="$HOME/.config/Antigravity" src_gm="$HOME/.gemini"
  [[ -d "$src_ud" ]] || die "没找到 $src_ud（默认那份从没启动过？）"
  [[ -n "$(slot_pids "$name" | head -1)" ]] && die "槽位 $name 正在运行，先 stop"
  if ps -eo args= 2>/dev/null | grep -q '[A]ntigravity-x64/antigravity'; then
    die "默认那份 Antigravity 正在运行，先关掉再迁移（否则会拷贝到一半状态）"
  fi
  if (( DRY )); then
    say "（dry-run）会复制："
    say "  $src_ud/.  → $d/userdata/"
    [[ -d "$src_gm" ]] && say "  $src_gm/.  → $d/home/.gemini/"
    return 0
  fi
  mkdir -p "$d"/{home,userdata,logs}
  cp -a "$src_ud/." "$d/userdata/"
  if [[ -d "$src_gm" ]]; then cp -a "$src_gm/." "$d/home/.gemini/"; fi
  sync_slot_xdg "$name"
  say "✔ 已把默认安装复制进槽位 $name（原目录保留，没动）"
  say "  启动：$0 run $name"
  say "  注意：槽位和默认安装现在是两份独立副本，登录态不会自动同步"
}

cmd_stop() {
  local name="$1" pids
  pids="$(slot_pids "$name" | tr '\n' ' ')"
  if [[ -z "${pids// }" ]]; then say "槽位 $name 没在跑"; return 0; fi
  (( DRY )) && { say "（dry-run）会 kill $pids"; return 0; }
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true
  sleep 2
  pids="$(slot_pids "$name" | tr '\n' ' ')"
  [[ -z "${pids// }" ]] && say "✔ 已停止 $name" || say "! 仍有残留：$pids"
}

cmd_rm() {
  local name="$1" d; d="$(slot_dir "$name")"
  [[ -d "$d" ]] || die "槽位不存在：$name"
  [[ -n "$(slot_pids "$name" | head -1)" ]] && die "槽位 $name 还在运行，先 stop"
  (( DRY )) && { say "（dry-run）会删除 $d"; return 0; }
  read -r -p "删除槽位 $name 的全部数据（含登录态）？[y/N] " a
  [[ "$a" == [yY] ]] || { say "已取消"; return 0; }
  rm -rf "$d"
  say "✔ 已删除 $name"
}

# ---------------------------------------------------------------- main
[[ $# -ge 1 ]] || { sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }
CMD="$1"; shift

# 解析通用开关（可在子命令前后）
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --gacc) [[ $# -ge 2 ]] || die "--gacc 后面要跟账户号"; GACC="$2"; shift 2 ;;
    --no-browser-switch) NO_BROWSER=1; shift ;;
    --) shift; ARGS+=("$@"); break ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

case "$CMD" in
  list)   cmd_list ;;
  status) cmd_status ;;
  new)    [[ ${#ARGS[@]} -ge 1 ]] || die "用法：$0 new <名字>"; cmd_new "${ARGS[0]}" ;;
  run)    [[ ${#ARGS[@]} -ge 1 ]] || die "用法：$0 run <名字> [--gacc N]"; cmd_run "${ARGS[0]}" "${ARGS[@]:1}" ;;
  login)  [[ ${#ARGS[@]} -ge 1 ]] || die "用法：$0 login <账户号>"; cmd_login "${ARGS[0]}" ;;
  adopt)  [[ ${#ARGS[@]} -ge 1 ]] || die "用法：$0 adopt <槽位名>"; cmd_adopt "${ARGS[0]}" ;;
  stop)   [[ ${#ARGS[@]} -ge 1 ]] || die "用法：$0 stop <名字>"; cmd_stop "${ARGS[0]}" ;;
  rm)     [[ ${#ARGS[@]} -ge 1 ]] || die "用法：$0 rm <名字>"; cmd_rm "${ARGS[0]}" ;;
  -h|--help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "不认识的子命令：$CMD（list/new/run/login/adopt/stop/rm/status）" ;;
esac
